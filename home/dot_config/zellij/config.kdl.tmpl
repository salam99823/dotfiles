plugins {
    about location="zellij:about"
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    tab-bar location="zellij:tab-bar"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
    // Custom plugins
    zjstatus location="file:~/.config/zellij/plugins/zjstatus.wasm"
    zjforgot location="file:~/.config/zellij/plugins/zellij_forgot.wasm"
    zjroom location="file:~/.config/zellij/plugins/room.wasm"
    // TODO: customize and build custom one
    // zjmultitask location="file:~/.config/zellij/plugins/multitask.wasm"
}

load_plugins {
  // zjmultitask {
  //     multitask_file_name ".multitask"
  // }
}

{{ includeTemplate .colorscheme (set . "template" "zellij") }}

{{- if eq .GUI "xorg" }}
copy_command "xclip -selection clipboard"
{{- else if eq .GUI "wayland" }}
copy_command "wl-copy"
{{- end }}

mouse_mode false
pane_frames false
mirror_session true
show_startup_tips false
mouse_scroll_resize false

on_quit "quit"
serialize_pane_viewport true
serialization_interval 300

terminal {
    font_size 13
    opacity 0.3
    blur true
    middle_click_paste false
    hide_pointer_while_typing true
}

default_layout "zjstatus"
keybinds preset="unlock-first" {
  shared_among "normal" "locked" {
    bind "Alt /" {
        LaunchOrFocusPlugin "zjforgot" {
            floating true
            "LOAD_ZELLIJ_BINDINGS" "false"

            // --- Zellij Mode Entry & Global ---
            "Zellij Locked Unlock to Normal Mode" "Ctrl + g"
            "Zellij Global Next / Prev Swap Layout (cycle panes)" "Alt + ] / Alt + ["
            "Zellij Global Toggle Floating Panes (popup overlay)" "Alt + f"
            "Zellij Global New Pane (split terminal)" "Alt + n"
            "Zellij Global Move Focus (navigate panes)" "Alt + h / j / k / l"
            "Zellij Global Resize Pane (grow / shrink)" "Alt + = / Alt + -"
            "Zellij Global Move Tab Left / Right (reorder)" "Alt + i / Alt + o"
            "Zellij Global Group / Mark Pane (sync)" "Alt + p / Alt + Shift + p"

            // --- Zellij Normal Mode ---
            "Zellij Normal Lock Mode" "Ctrl + g / Enter"
            "Zellij Normal Tab Switcher / Fuzzy Jump (zjroom)" "f"
            "Zellij Normal New Project Tab (zj projects)" "d"
            "Zellij Normal New Ref Tab (zj refs)" "Shift + d"
            "Zellij Normal New Config Tab (zj config)" "c"
            "Zellij Normal Lazygit (lazygit)" "g"
            "Zellij Normal Network Manager Wi-Fi (nmtui)" "Shift + n"
            "Zellij Normal Bluetooth Manager (bluetuith)" "Shift + b"
            "Zellij Normal Cheatsheet / Keybinds (zjforgot)" "/"
            "Zellij Normal Enter Pane / Tab / Resize / Move Mode" "p / t / r / m"
            "Zellij Normal Enter Scroll / Session Mode" "s / o"
            "Zellij Normal Quit / Exit Session" "Ctrl + q"

            // --- Zellij Pane Mode ---
            "Zellij Pane Split Down / Right / Stacked" "d / r / s"
            "Zellij Pane Close Focused Pane" "x"
            "Zellij Pane Fullscreen Pane (maximize)" "f"
            "Zellij Pane Embed or Float Pane" "e"
            "Zellij Pane Rename Pane" "c"
            "Zellij Pane Pin / Mute / Watch Pane" "i / u / v"

            // --- Zellij Tab Mode ---
            "Zellij Tab Switcher / Fuzzy Jump (zjroom)" "f"
            "Zellij Tab New Project Tab (zj projects)" "d"
            "Zellij Tab New Ref Tab (zj refs)" "Shift + d"
            "Zellij Tab New Config Tab (zj config)" "c"
            "Zellij Tab New Tab / Close Tab" "n / x"
            "Zellij Tab Rename Tab" "r"
            "Zellij Tab Break Pane to New / Left / Right Tab" "b / [ / ]"
            "Zellij Tab Sync Input Across Panes" "s"
            "Zellij Tab Switch to Tab 1-9" "1..9"

            // --- Zellij Scroll & Session Mode ---
            "Zellij Scroll Edit Scrollback in Editor (dump buffer)" "e"
            "Zellij Scroll Search Text" "f"
            "Zellij Scroll Copy Last Command Output (clipboard)" "c"
            "Zellij Session Detach Session" "d"
            "Zellij Session Session Manager (switch / attach)" "w"
            "Zellij Session Rename Session" "r"

            // --- Sway Window Manager Modes ---
            "Sway Mouse Move Cursor Fast (+Shift)" "Shift + Arrows"
            "Sway Mouse Move Cursor" "Arrows"
            "Sway Mouse Left / Middle / Right Click" "s / d / f"
            "Sway Record Screen Capture / With Audio (+Shift)" "r / Shift + r"
            "Sway Resize Resize Window" "Arrows"
            "Sway Resize Increase / Decrease Gaps" "+ / -"
            "Sway Picker Pick Color" "p"
            "Sway Picker Output Screenshot / Upload (+Shift)" "o / Shift + o"
            "Sway Power Lock / Logout" "l / e"
            "Sway Power Reboot / Suspend / Shutdown" "r / u / s"
        }
    }
    bind "Alt w" {
        LaunchOrFocusPlugin "zjroom" {
            floating true
            ignore_case true
            quick_jump true
        }
    }
  }
  shared_among "normal" "tab" {
    bind "Shift d" {
        Run "zj" "refs" {
            floating true
            close_on_exit true
        }
        SwitchToMode "Locked"
    }
    bind "d" {
        Run "zj" "projects" {
            floating true
            close_on_exit true
        }
        SwitchToMode "Locked"
    }
    bind "c" {
        Run "zj" "config" {
            floating true
            close_on_exit true
        }
        SwitchToMode "Locked"
    }
    bind "f" {
        LaunchOrFocusPlugin "zjroom" {
            floating true
            ignore_case true
            quick_jump true
        }
        SwitchToMode "Locked"
    }
  }
  shared_among "normal" {
    bind "e" {
        Run "zj" "run" {
            floating true
            close_on_exit true
        }
        SwitchToMode "Locked"
    }
    bind "Shift e" {
        Run "zj" "exec" {
            floating true
            close_on_exit true
        }
        SwitchToMode "Locked"
    }
    bind "g" {
        Run "lazygit" {
            floating true
            close_on_exit true
        }
        SwitchToMode "Locked"
    }
    bind "Shift n" {
        Run "nmtui" {
            floating true
            close_on_exit true
        }
        SwitchToMode "Locked"
    }
    bind "Shift b" {
        Run "bluetuith" {
            floating true
            close_on_exit true
        }
        SwitchToMode "Locked"
    }
  }
}
